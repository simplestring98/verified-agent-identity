name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Simplestring'
        required: true
        default: 'Simplestring'
      agent_description:
        description: 'Simplestring'
        required: true
        default: 'Simplestring AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      # 🔥 WAJIB: reset semua
      - name: Clean environment
        run: |
          npm cache clean --force
          rm -rf ~/.openclaw

      # 🔥 WAJIB: install ulang circuit
      - name: Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity --force

      - name: Install script dependencies
        run: |
          cd scripts
          npm install

      - name: Create new Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js

      # 🔥 PRINT LINK BIAR JELAS
      - name: Link Human to Agent
        run: |
          echo "🚀 START LINKING..."
          node scripts/manualLinkHumanToAgent.js \
          --challenge "{\"name\":\"${{ github.event.inputs.agent_name }}\",\"description\":\"${{ github.event.inputs.agent_description }}\"}"
